{
  "compileOnSave": false,
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vscode"],
    "strict": true,
    "alwaysStrict": true,
    "target": "esnext",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["src", "webview"]
}
